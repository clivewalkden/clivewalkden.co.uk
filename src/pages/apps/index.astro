---
import { Image } from 'astro:assets';
import { site } from '../../data/site.ts';
import cairnMarkRaw from '../../assets/images/cairn/cairn.svg?raw';
import trailheadIcon from '../../assets/images/trailhead/trailhead-icon.png';

const meta_title = 'Android Apps by Clive Walkden — Cairn & Trailhead';
const meta_description = 'Privacy-first Android apps by Clive Walkden: Cairn, a body-measurement tracker for Android & Wear OS, and Trailhead, a workout-programme tracker. No accounts, no analytics, no ads.';
const canonicalUrl = 'https://clivewalkden.co.uk/apps/';
const ogImage = `${site.baseUrl}/assets/images/cairn/cairn-home-screen.png`;

const apps = [
  {
    key: 'cairn',
    name: 'Cairn',
    tagline: 'Body-measurement tracker for Android & Wear OS',
    description: 'Logs weight, body composition and heart rate straight into Android Health Connect, and reads your watch’s own steps, sleep and activity back for context.',
    status: 'In closed testing on Google Play',
    href: '/apps/cairn/',
    privacyHref: '/apps/cairn/privacy/',
    markRaw: cairnMarkRaw,
  },
  {
    key: 'trailhead',
    name: 'Trailhead',
    tagline: 'Workout-programme tracker for Android',
    description: 'Lines up your next session, reminds you on training days, and counts progress in sessions, not dates — the companion to Cairn.',
    status: 'In development, preparing for closed testing',
    href: '/apps/trailhead/',
    privacyHref: '/apps/trailhead/privacy/',
    icon: trailheadIcon,
  },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href={canonicalUrl}>
    <meta name="description" content={meta_description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:title" content={meta_title}>
    <meta property="og:description" content={meta_description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:site_name" content="Clive Walkden">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={meta_title}>
    <meta name="twitter:description" content={meta_description}>
    <meta name="twitter:image" content={ogImage}>
    <link rel="icon" href="/favicon.ico">
    <title>{meta_title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
      :root {
        --cream: #FAF6F0;
        --ink: #3A2E27;
        --ink-soft: #6b5d53;
        --terracotta: #C97C5D;
        --terracotta-deep: #a85f42;
        --sage: #8CA394;
        --sand: #E8C9A0;
        --rule: #e4d7c6;
        --card: #ffffff;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --cream: #2A2521;
          --ink: #F0E6DC;
          --ink-soft: #cbbfb4;
          --terracotta: #d99677;
          --terracotta-deep: #e8b299;
          --sage: #a3bcac;
          --sand: #6b5a42;
          --rule: #423a33;
          --card: #332c27;
        }
      }
      :root[data-theme="dark"] {
        --cream: #2A2521;
        --ink: #F0E6DC;
        --ink-soft: #cbbfb4;
        --terracotta: #d99677;
        --terracotta-deep: #e8b299;
        --sage: #a3bcac;
        --sand: #6b5a42;
        --rule: #423a33;
        --card: #332c27;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--cream);
        color: var(--ink);
        font-family: 'Nunito Sans', 'Segoe UI', system-ui, sans-serif;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      img { max-width: 100%; display: block; }
      h1, h2 {
        font-family: 'Fraunces', Georgia, 'Times New Roman', serif;
        font-optical-sizing: auto;
        color: var(--ink);
        text-wrap: balance;
      }
      a { color: var(--terracotta-deep); }

      .page {
        max-width: 760px;
        margin: 0 auto;
        padding: 64px 24px 96px;
      }

      .breadcrumb {
        font-size: 13.5px;
        color: var(--ink-soft);
        margin-bottom: 28px;
      }
      .breadcrumb a { color: var(--ink-soft); text-decoration: none; border-bottom: 1px solid currentColor; }
      .breadcrumb a:hover { color: var(--terracotta-deep); }

      h1 { font-size: 36px; font-weight: 600; margin: 0 0 16px; }
      .lede { font-size: 18px; color: var(--ink); max-width: 560px; margin: 0 0 56px; }

      .app-card {
        display: flex;
        gap: 20px;
        background: var(--card);
        border: 1px solid var(--rule);
        border-radius: 14px;
        padding: 26px 28px;
        text-decoration: none;
        color: inherit;
        margin-bottom: 24px;
      }
      .app-icon { width: 56px; height: 56px; flex-shrink: 0; border-radius: 12px; overflow: hidden; }
      .app-icon svg, .app-icon img { width: 100%; height: 100%; display: block; }
      .app-name { font-family: 'Fraunces', Georgia, serif; font-size: 22px; font-weight: 600; margin: 0 0 2px; }
      .app-tagline { color: var(--ink-soft); font-size: 14px; margin-bottom: 10px; }
      .app-description { font-size: 15px; margin: 0 0 14px; }
      .app-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 12.5px;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 999px;
        background: var(--cream);
        border: 1px solid var(--rule);
        color: var(--ink-soft);
      }
      .status-pill .dot { width: 6px; height: 6px; border-radius: 999px; background: var(--sage); flex-shrink: 0; }
      .app-links { display: flex; gap: 16px; font-size: 14px; font-weight: 600; }
      .app-links a { text-decoration: none; border-bottom: 1px solid currentColor; }
      .app-links a.secondary { color: var(--ink-soft); }

      footer {
        margin-top: 56px;
        padding-top: 24px;
        border-top: 1px solid var(--rule);
        font-size: 14px;
        color: var(--ink-soft);
      }
      footer a { color: var(--terracotta-deep); text-decoration: none; border-bottom: 1px solid currentColor; }
      footer a:hover { opacity: 0.75; }

      @media (max-width: 480px) {
        .app-card { flex-direction: column; }
      }
    </style>
  </head>
  <body>
    <div class="page">

      <div class="breadcrumb"><a href="/">clivewalkden.co.uk</a> / Apps</div>

      <h1>Apps</h1>
      <p class="lede">
        Android apps built on the same principle: your data lives on your device, in Android
        Health Connect where it belongs, not on a server. No accounts, no analytics, no adverts.
      </p>

      {apps.map((app) => (
        <div class="app-card">
          <div class="app-icon">
            {app.markRaw ? <Fragment set:html={app.markRaw} /> : <Image src={app.icon} alt={`${app.name} app icon`} width={112} height={112} />}
          </div>
          <div>
            <h2 class="app-name">{app.name}</h2>
            <div class="app-tagline">{app.tagline}</div>
            <p class="app-description">{app.description}</p>
            <div class="app-meta">
              <span class="status-pill"><span class="dot"></span> {app.status}</span>
              <div class="app-links">
                <a href={app.href}>App page</a>
                <a class="secondary" href={app.privacyHref}>Privacy policy</a>
              </div>
            </div>
          </div>
        </div>
      ))}

      <footer>
        Also in the <a href="/portfolio/">portfolio</a> &mdash; questions about either app, <a href="mailto:clivewalkden@gmail.com">clivewalkden@gmail.com</a>.
      </footer>

    </div>
  </body>
</html>
