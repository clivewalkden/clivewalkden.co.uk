---
import { Image } from 'astro:assets';
import { site } from '../../../data/site.ts';
import iconImg from '../../../assets/images/trailhead/trailhead-icon.png';
import homeImg from '../../../assets/images/trailhead/trailhead-home.png';
import libraryImg from '../../../assets/images/trailhead/trailhead-library.png';
import todayImg from '../../../assets/images/trailhead/trailhead-today.png';
import newProgrammesImg from '../../../assets/images/trailhead/trailhead-new-programmes.png';

const meta_title = 'Trailhead — Workout-programme Tracker for Android';
const meta_description = 'Trailhead keeps you to a workout programme: it lines up your next session, reminds you on training days, and tracks progress in sessions, not dates. No account, no analytics, no adverts.';
const canonicalUrl = 'https://clivewalkden.co.uk/apps/trailhead/';
const ogImage = `${site.baseUrl}/assets/images/trailhead/trailhead-home.png`;

const screenshots = [
  { src: homeImg, alt: 'Trailhead home screen with the opt-in question for checking new programmes and the reminders section', caption: 'Home' },
  { src: libraryImg, alt: 'Trailhead programme library with filters for focus, equipment, difficulty and length', caption: 'Library' },
  { src: todayImg, alt: "Trailhead Today card mid-session, showing the current exercise, sets and a Start activity button", caption: 'Today' },
  { src: newProgrammesImg, alt: 'Trailhead home screen showing a banner for newly available programmes to download', caption: 'New programmes' },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href={canonicalUrl}>
    <meta name="description" content={meta_description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:title" content={meta_title}>
    <meta property="og:description" content={meta_description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:site_name" content="Trailhead">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={meta_title}>
    <meta name="twitter:description" content={meta_description}>
    <meta name="twitter:image" content={ogImage}>
    <link rel="icon" href="/favicon.ico">
    <title>{meta_title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
      :root {
        --cream: #FAF6F0;
        --ink: #3A2E27;
        --ink-soft: #6b5d53;
        --terracotta: #C97C5D;
        --terracotta-deep: #a85f42;
        --sage: #8CA394;
        --sand: #E8C9A0;
        --rule: #e4d7c6;
        --card: #ffffff;
        --dashboard-bg: #f3e9df;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --cream: #2A2521;
          --ink: #F0E6DC;
          --ink-soft: #cbbfb4;
          --terracotta: #d99677;
          --terracotta-deep: #e8b299;
          --sage: #a3bcac;
          --sand: #6b5a42;
          --rule: #423a33;
          --card: #332c27;
        }
      }
      :root[data-theme="dark"] {
        --cream: #2A2521;
        --ink: #F0E6DC;
        --ink-soft: #cbbfb4;
        --terracotta: #d99677;
        --terracotta-deep: #e8b299;
        --sage: #a3bcac;
        --sand: #6b5a42;
        --rule: #423a33;
        --card: #332c27;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--cream);
        color: var(--ink);
        font-family: 'Nunito Sans', 'Segoe UI', system-ui, sans-serif;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      img { max-width: 100%; display: block; }
      h1, h2 {
        font-family: 'Fraunces', Georgia, 'Times New Roman', serif;
        font-optical-sizing: auto;
        color: var(--ink);
        text-wrap: balance;
      }
      a { color: var(--terracotta-deep); }

      .page {
        max-width: 960px;
        margin: 0 auto;
        padding: 64px 24px 96px;
      }

      .breadcrumb {
        font-size: 13.5px;
        color: var(--ink-soft);
        margin-bottom: 28px;
      }
      .breadcrumb a { color: var(--ink-soft); text-decoration: none; border-bottom: 1px solid currentColor; }
      .breadcrumb a:hover { color: var(--terracotta-deep); }

      /* Masthead — the app's own icon, same file as the privacy policy page */
      .masthead { display: flex; align-items: center; gap: 18px; margin-bottom: 8px; }
      .mark { width: 46px; height: 46px; flex-shrink: 0; border-radius: 10px; overflow: hidden; }
      .mark img { width: 100%; height: 100%; display: block; }

      .wordmark { font-family: 'Fraunces', Georgia, serif; font-size: 26px; font-weight: 600; letter-spacing: 0.2px; }
      .tagline { color: var(--ink-soft); font-size: 14.5px; margin-top: 2px; }

      /* Hero */
      .hero { margin-top: 56px; max-width: 560px; }
      .hero h1 { font-size: 40px; font-weight: 600; margin: 0 0 18px; }
      .hero p { font-size: 18px; margin: 0 0 14px; }
      .hero .lede strong { color: var(--terracotta-deep); font-weight: 700; }

      .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin: 30px 0; }
      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        font-weight: 600;
        padding: 11px 18px;
        border-radius: 999px;
        background: var(--card);
        border: 1px solid var(--rule);
        color: var(--ink-soft);
      }
      .status-pill .dot {
        width: 7px; height: 7px; border-radius: 999px;
        background: var(--sage);
        flex-shrink: 0;
        animation: pulse 2.2s ease-in-out infinite;
      }
      @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
      .btn-secondary {
        display: inline-flex;
        align-items: center;
        font-size: 14px;
        font-weight: 600;
        padding: 11px 20px;
        border-radius: 999px;
        background: transparent;
        border: 1px solid var(--terracotta-deep);
        color: var(--terracotta-deep);
        text-decoration: none;
      }
      .btn-secondary:hover { background: color-mix(in srgb, var(--terracotta) 12%, transparent); }

      /* Screenshot strip */
      .shots {
        margin-top: 64px;
        display: flex;
        gap: 20px;
        overflow-x: auto;
        padding: 6px 6px 18px;
        scroll-snap-type: x proximity;
        -webkit-overflow-scrolling: touch;
      }
      .shot { flex: 0 0 auto; width: 200px; scroll-snap-align: start; text-align: center; }
      .shot-frame {
        border-radius: 22px;
        overflow: hidden;
        background: var(--dashboard-bg);
        border: 1px solid var(--rule);
        box-shadow: 0 12px 30px -14px rgba(58, 46, 39, 0.35);
      }
      .shot-frame img { width: 100%; height: auto; }
      .shot-caption { margin-top: 10px; font-size: 13.5px; color: var(--ink-soft); font-weight: 600; }

      /* Feature grid */
      section { margin-top: 72px; }
      section h2 {
        font-size: 24px;
        font-weight: 600;
        margin: 0 0 28px;
      }
      .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
      }
      .feature {
        background: var(--card);
        border: 1px solid var(--rule);
        border-radius: 12px;
        padding: 20px 22px;
      }
      .feature h3 {
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 8px;
        color: var(--ink);
      }
      .feature h3::before {
        content: '';
        display: inline-block;
        width: 7px; height: 7px;
        border-radius: 999px;
        background: var(--sage);
        margin-right: 9px;
        transform: translateY(-2px);
      }
      .feature p { margin: 0; font-size: 14.5px; color: var(--ink-soft); }

      /* Privacy callout, same voice as the policy page */
      .privacy-callout {
        margin-top: 72px;
        background: var(--card);
        border: 1px solid var(--rule);
        border-left: 3px solid var(--sage);
        border-radius: 4px;
        padding: 26px 28px;
      }
      .privacy-callout h2 { font-size: 20px; margin: 0 0 10px; }
      .privacy-callout p { margin: 0 0 14px; font-size: 15px; }
      .privacy-callout p:last-child { margin-bottom: 0; }
      .privacy-callout a { font-weight: 600; text-decoration: none; border-bottom: 1px solid currentColor; }

      footer {
        margin-top: 56px;
        padding-top: 24px;
        border-top: 1px solid var(--rule);
        font-size: 14px;
        color: var(--ink-soft);
      }
      footer a { color: var(--terracotta-deep); text-decoration: none; border-bottom: 1px solid currentColor; }
      footer a:hover { opacity: 0.75; }
      footer .pairs-with { margin-top: 8px; }

      @media (max-width: 520px) {
        .hero h1 { font-size: 32px; }
      }
    </style>
  </head>
  <body>
    <div class="page">

      <div class="breadcrumb"><a href="/">clivewalkden.co.uk</a> / <a href="/apps/">Apps</a> / Trailhead</div>

      <div class="masthead">
        <div class="mark">
          <Image src={iconImg} alt="Trailhead app icon" width={92} height={92} />
        </div>
        <div>
          <div class="wordmark">Trailhead</div>
          <div class="tagline">Workout-programme tracker for Android &mdash; the companion to Cairn</div>
        </div>
      </div>

      <div class="hero">
        <h1>Pick a programme. Keep showing up.</h1>
        <p class="lede">
          Trailhead lines up your next session, reminds you on your training days, and counts
          progress in <strong>sessions, not dates</strong> &mdash; so a missed day loses nothing. <strong>No
          account, no analytics, no adverts</strong> &mdash; your progress and
          measurements never leave your phone.
        </p>
        <div class="cta-row">
          <span class="status-pill"><span class="dot"></span> In development &mdash; closed testing coming soon</span>
          <a class="btn-secondary" href="/apps/trailhead/privacy/">Read the privacy policy</a>
        </div>
      </div>

      <div class="shots" role="list" aria-label="Trailhead screenshots">
        {screenshots.map((shot) => (
          <div class="shot" role="listitem">
            <div class="shot-frame">
              <Image src={shot.src} alt={shot.alt} width={280} loading="eager" />
            </div>
            <div class="shot-caption">{shot.caption}</div>
          </div>
        ))}
      </div>

      <section>
        <h2>What it does</h2>
        <div class="feature-grid">
          <div class="feature">
            <h3>A real programme library</h3>
            <p>Abs, Arms, Legs, military conditioning and more, in Easy/Tough/Extreme and 4- or 8-week lengths. A few ship in the app; the rest are an opt-in download.</p>
          </div>
          <div class="feature">
            <h3>A Today card that remembers your place</h3>
            <p>Next session, its steps and form cues, Done or Not today. Undo is exact, and you choose whether to move on or repeat a week at the end of each phase.</p>
          </div>
          <div class="feature">
            <h3>Guided workouts</h3>
            <p>A timer for each exercise, a rest countdown with beeps, pause or end any time. Optionally saves the finished workout to Health Connect &mdash; off by default.</p>
          </div>
          <div class="feature">
            <h3>Reminders that stay quiet when earned</h3>
            <p>A daily notification on your training days, silent if you've already trained. Mark a session done straight from the notification.</p>
          </div>
          <div class="feature">
            <h3>Progress without guilt</h3>
            <p>Weekly consistency and streaks &mdash; a week still in progress never breaks one &mdash; plus weight, body fat and height trends read from Health Connect.</p>
          </div>
          <div class="feature">
            <h3>Your own backup</h3>
            <p>Save progress to a file you choose and restore it after reinstalling or switching phones. There is deliberately no cloud backup.</p>
          </div>
        </div>
      </section>

      <div class="privacy-callout">
        <h2>Private by design</h2>
        <p>
          Trailhead has no account, no adverts and no analytics. Your progress and measurements
          stay on your phone. The only thing it uses the internet for is an optional, off-by-default
          check for new programmes, which sends nothing about you.
        </p>
        <p>
          <a href="/apps/trailhead/privacy/">Read the full privacy policy &rarr;</a>
        </p>
      </div>

      <footer>
        Questions about Trailhead &mdash; <a href="mailto:clivewalkden@gmail.com">clivewalkden@gmail.com</a>
        <div class="pairs-with">Pairs well with <a href="/apps/cairn/">Cairn</a>, a body-measurement tracker for Android &amp; Wear OS.</div>
      </footer>

    </div>
  </body>
</html>
